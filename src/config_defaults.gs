/**
 * config_defaults.gs
 * Default values for the OPTIONAL settings. Users do NOT edit this file: they only
 * override what they need inside `CONFIG` in config.gs (any key that is missing there
 * falls back to these defaults, so older config.gs files keep working).
 *
 * Example (config.gs):
 *   const CONFIG = {
 *     ...
 *     BIZUM_BANK: "Caixabank",
 *     DASHBOARD: { GOAL: { NAME: "Coche", EMOJI: "🚗", AMOUNT: 15000 } }
 *   };
 */

const DEFAULT_DASHBOARD_SETTINGS = {
  LOCALE: "es-ES",                       // number/date format of the dashboard
  GOAL: {                                // savings goal shown in Patrimonio (set AMOUNT > 0 to enable)
    ENABLED: true,
    NAME:    "Entrada Vivienda",
    EMOJI:   "🏡",
    AMOUNT:  0
  },
  RULE_5030: {                           // 50/30/20 rule (Presupuesto tab)
    TARGETS:  { Necesidades: 50, Deseos: 30, Ahorro: 20 },
    TOLERANCE_PP: 5,                     // percentage points before a bucket turns red
    DEFAULT_BUCKET: "Deseos",            // for categories that are not listed below
    CATEGORY_MAP: {                      // category -> "Necesidades" | "Deseos"  (savings = "Inversión y ahorro")
      "Vivienda": "Necesidades", "Alimentación": "Necesidades", "Transporte": "Necesidades",
      "Salud": "Necesidades", "Impuestos y multas": "Necesidades",
      "Ocio": "Deseos", "Ropa y calzado": "Deseos", "Regalos y donaciones": "Deseos", "Otros": "Deseos"
    },
    SUBCATEGORY_OVERRIDES: {             // "Category|Subcategory" -> bucket
      "Alimentación|Restaurante": "Deseos"
    }
  },
  NO_RETURN_CLASSES: ["Efectivo"],       // asset classes that never show a return
  PREVISTO_BASIS: "monthly",             // "monthly" = `previsto` is already monthly; "annual" = divide by 12
  BULLET_MODE: "percent"                 // "percent" | "absolute" (budget bullet chart)
};

/** Recursively merges `override` over `base` (objects are merged, arrays/values replaced). */
function _deepMerge(base, override) {
  if (override === undefined || override === null) return base;
  if (typeof base !== "object" || base === null || Array.isArray(base)) return override;
  const out = Object.assign({}, base);
  Object.keys(override).forEach(k => {
    out[k] = (typeof base[k] === "object" && base[k] !== null && !Array.isArray(base[k]) &&
              typeof override[k] === "object" && override[k] !== null && !Array.isArray(override[k]))
      ? _deepMerge(base[k], override[k])
      : override[k];
  });
  return out;
}

/** Dashboard configuration sent to the web app together with the data. */
function getDashboardConfig() {
  const d = _deepMerge(DEFAULT_DASHBOARD_SETTINGS, (typeof CONFIG !== "undefined" && CONFIG.DASHBOARD) || {});
  const amount = Number(d.GOAL.AMOUNT) || 0;
  return {
    locale:   d.LOCALE,
    currency: (typeof CONFIG !== "undefined" && CONFIG.CURRENCY) || "EUR",
    goal: { enabled: d.GOAL.ENABLED !== false && amount > 0, name: d.GOAL.NAME, emoji: d.GOAL.EMOJI, amount: amount },
    rule5030: {
      targets: d.RULE_5030.TARGETS,
      tolerancePp: Number(d.RULE_5030.TOLERANCE_PP),
      defaultBucket: d.RULE_5030.DEFAULT_BUCKET,
      categoryMap: d.RULE_5030.CATEGORY_MAP,
      subcategoryOverrides: d.RULE_5030.SUBCATEGORY_OVERRIDES
    },
    noReturnClasses: d.NO_RETURN_CLASSES,
    previstoBasis: d.PREVISTO_BASIS,
    bulletMode: d.BULLET_MODE
  };
}
